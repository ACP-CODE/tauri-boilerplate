{
  "name": "root",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo workspace for Tauri 2 applications.",
  "license": "MIT",
  "author": "Cyril",
  "type": "module",
  "scripts": {
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vpr -r test",
    "test:e2e": "sh -c 'vpr --filter \"${1:-application}-e2e\" wdio' --",
    "dev": "sh -c 'vpr --filter \"${1:-application}\" tauri dev' --",
    "build": "sh -c 'vpr --filter \"${1:-application}\" tauri build' --",
    "ready": "vpr check && vpr test && vpr build"
  },
  "devDependencies": {
    "vite-plus": "^0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
