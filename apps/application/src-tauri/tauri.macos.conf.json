{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.org.Application",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "title": "Application",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ]
  },
  "bundle": {
    "resources": {
      "Resources/en.lproj": "en.lproj",
      "Resources/zh-Hans.lproj": "zh-Hans.lproj",
      "Resources/zh-Hant.lproj": "zh-Hant.lproj",
      "Resources/Credits.rtf": "Credits.rtf"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    }
  }
}
