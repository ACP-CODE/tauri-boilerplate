{
  "name": "root",
  "version": "0.1.0",
  "private": true,
  "description": "A monorepo workspace for Tauri 2 applications.",
  "license": "MIT",
  "author": "Cyril",
  "type": "module",
  "scripts": {
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test:ci": "vpr -r test",
    "test": "node scripts/run.mjs test",
    "test:e2e": "node scripts/run.mjs test:e2e",
    "prebuild": "vpr check && vpr test:ci",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "compile": "node scripts/run.mjs compile",
    "vite": "node scripts/run.mjs vite",
    "tauri": "node scripts/run.mjs tauri",
    "wdio": "node scripts/run.mjs wdio",
    "vsce": "node scripts/run.mjs vsce",
    "tsc": "node scripts/run.mjs tsc",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "vite-plus": "^0.3.0"
  },
  "config": {
    "app": "application"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
